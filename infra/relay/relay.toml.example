[server]
# MUST equal RELAY_AUDIENCE in .env exactly (control-plane's aud claim is checked
# against this string byte-for-byte). On the default single-domain install this
# is https://{DOMAIN_BASE}; if you put the relay on its own subdomain instead
# (a supported layout, see docs/reverse-proxy.md), it's https://{RELAY_DOMAIN}
# — either way, this must be the exact host your relay is actually served on.
# If you leave RELAY_AUDIENCE unset, the control-plane derives the same value
# from RELAY_PUBLIC_URL's host — see docs/configuration.md.
url = "https://example.com"
host = "0.0.0.0"
port = 8080

[metrics]
port = 9090

[logging]
level = "info"
format = "pretty"

# Auth keys from control plane
# Get these values from: curl https://cp.YOUR_DOMAIN/keys/public
# RELAY_PRIVATE_KEY must be set in .env before the control plane will start — it is
# required, and no keypair is generated for you. The public half below is derived from
# it, so it only changes when you change the private key.
[[auth]]
key_id = "REPLACE_WITH_KEY_ID"
public_key = "REPLACE_WITH_PUBLIC_KEY_BASE64"

[store]
type = "minio"
bucket = "relay"
endpoint = "http://minio:9000"
access_key = "MINIO_ROOT_USER"
secret_key = "MINIO_ROOT_PASSWORD"
prefix = ""
